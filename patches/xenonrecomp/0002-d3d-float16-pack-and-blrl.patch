diff --git a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
index c6b6faa..fd546e6 100644
--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -624,6 +624,125 @@ inline uint8_t VectorShiftTableR[] =
     0x10, 0x0F, 0x0E, 0x0D, 0x0C, 0x0B, 0x0A, 0x09, 0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01,
 };
 
+// ---------------------------------------------------------------------------
+// vpkd3d128 / vupkd3d128 types that upstream XenonRecomp leaves as
+// __builtin_debugtrap(). Semantics from Xenia (src/xenia/cpu/ppc/
+// ppc_emit_altivec.cc, InstrEmit_vpkd3d128 / InstrEmit_vupkd3d128, and
+// src/xenia/cpu/backend/x64/x64_seq_vector.cc, PACK / UNPACK FLOAT16_2 and
+// FLOAT16_4). Vectors are byte-reversed as described above: guest word i is
+// host u32[3 - i], guest float i is host f32[3 - i].
+// ---------------------------------------------------------------------------
+
+// float -> IEEE 754 binary16, rounding toward zero, as Xenia's PACK_TYPE_FLOAT16_*
+// (vcvtps2ph with imm 0b11 on F16C hosts, half_float::float2half<round_toward_zero>
+// otherwise): finite overflow -> largest finite half (0x7BFF), inf -> inf,
+// NaN -> quiet NaN keeping the top payload bits (vcvtps2ph). Bit-exact
+// integer code, independent of MXCSR.
+inline uint16_t ppc_float_to_half_rtz(float f) noexcept
+{
+    uint32_t bits;
+    std::memcpy(&bits, &f, sizeof(bits));
+    const uint16_t sign = uint16_t((bits >> 16) & 0x8000);
+    const uint32_t exp = (bits >> 23) & 0xFF;
+    const uint32_t man = bits & 0x7FFFFF;
+    if (exp == 0xFF)
+        return sign | 0x7C00 | (man ? uint16_t(0x200 | (man >> 13)) : uint16_t(0));
+    const int e = int(exp) - 127 + 15;
+    if (e >= 31)
+        return sign | 0x7BFF;
+    if (e <= 0)  // half subnormal (or zero): value = m * 2^-24
+        return e < -10 ? sign : uint16_t(sign | ((man | 0x800000) >> (14 - e)));
+    return uint16_t(sign | (e << 10) | (man >> 13));
+}
+
+// IEEE 754 binary16 -> float (exact), as Xenia's UNPACK FLOAT16_* (vcvtph2ps /
+// half_float::detail::half2float); NaN stays NaN (quieted, as vcvtph2ps).
+inline float ppc_half_to_float(uint16_t h) noexcept
+{
+    const uint32_t sign = uint32_t(h & 0x8000) << 16;
+    const uint32_t exp = (h >> 10) & 0x1F;
+    uint32_t man = h & 0x3FF;
+    uint32_t bits;
+    if (exp == 0x1F)
+        bits = sign | 0x7F800000 | (man << 13) | (man ? 0x400000u : 0u);
+    else if (exp != 0)
+        bits = sign | ((exp + 127 - 15) << 23) | (man << 13);
+    else if (man == 0)
+        bits = sign;
+    else
+    {
+        uint32_t e = 127 - 14;  // normalise the subnormal m * 2^-24
+        while (!(man & 0x400))
+        {
+            man <<= 1;
+            --e;
+        }
+        bits = sign | (e << 23) | ((man & 0x3FF) << 13);
+    }
+    float f;
+    std::memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+// Inserts the packed result into vD as Xenia's InstrEmit_vpkd3d128 does:
+// Permute(control, vD, packed, INT32) with the MakePermuteMask table for
+// pack (1 = VPACK_32, 2 and 3 = 64 bit) and shift 0-3. Each entry is the
+// guest lane source: bit 2 = from the packed vector, bits 0-1 = lane index.
+inline void ppc_vpkd3d128_insert(PPCVRegister& d, const uint32_t packed[4], uint32_t pack, uint32_t shift) noexcept
+{
+    static constexpr uint8_t kLanes[3][4][4] = {
+        {{0, 1, 2, 7}, {0, 1, 7, 3}, {0, 7, 2, 3}, {7, 1, 2, 3}},  // pack 1
+        {{0, 1, 6, 7}, {0, 6, 7, 3}, {6, 7, 2, 3}, {7, 1, 2, 3}},  // pack 2
+        {{0, 1, 6, 7}, {0, 6, 7, 3}, {6, 7, 2, 3}, {0, 1, 2, 6}},  // pack 3
+    };
+    uint32_t old[4], out[4];
+    for (int i = 0; i < 4; i++)
+        old[i] = d.u32[3 - i];
+    for (int i = 0; i < 4; i++)
+    {
+        const uint8_t e = kLanes[(pack - 1) & 3][shift & 3][i];
+        out[i] = (e & 4) ? packed[e & 3] : old[e & 3];
+    }
+    for (int i = 0; i < 4; i++)
+        d.u32[3 - i] = out[i];
+}
+
+// vpkd3d128 vD,vB,3,pack,shift (VPACK_FLOAT16_2, R16G16_FLOAT): packed guest
+// word w = half(x) << 16 | half(y), words x-z = 0 (x64 EmitFLOAT16_2,
+// XMMPackFLOAT16_2), then inserted per pack/shift. pack must be 1-3.
+inline void ppc_vpkd3d128_float16_2(PPCVRegister& d, const PPCVRegister& b, uint32_t pack, uint32_t shift) noexcept
+{
+    const uint32_t packed[4] = {0, 0, 0,
+                                (uint32_t(ppc_float_to_half_rtz(b.f32[3])) << 16) | ppc_float_to_half_rtz(b.f32[2])};
+    ppc_vpkd3d128_insert(d, packed, pack, shift);
+}
+
+// vupkd3d128 vD,vB,12 (type 3, VPACK_FLOAT16_2): (half(w >> 16), half(w & 0xFFFF),
+// 0.0, 1.0) from guest word w (x64 EmitFLOAT16_2, XMMUnpackFLOAT16_2, XMM0001).
+inline void ppc_vupkd3d128_float16_2(PPCVRegister& d, const PPCVRegister& b) noexcept
+{
+    const uint32_t w = b.u32[0];
+    const float x = ppc_half_to_float(uint16_t(w >> 16)), y = ppc_half_to_float(uint16_t(w));
+    d.f32[3] = x;
+    d.f32[2] = y;
+    d.f32[1] = 0.0f;
+    d.f32[0] = 1.0f;
+}
+
+// vupkd3d128 vD,vB,20 (type 5, VPACK_FLOAT16_4): x, y from the halves of guest
+// word z and z, w from those of guest word w, high half first (x64
+// EmitFLOAT16_4, XMMUnpackFLOAT16_4).
+inline void ppc_vupkd3d128_float16_4(PPCVRegister& d, const PPCVRegister& b) noexcept
+{
+    const uint32_t zw = b.u32[1], ww = b.u32[0];
+    const float x = ppc_half_to_float(uint16_t(zw >> 16)), y = ppc_half_to_float(uint16_t(zw));
+    const float z = ppc_half_to_float(uint16_t(ww >> 16)), w = ppc_half_to_float(uint16_t(ww));
+    d.f32[3] = x;
+    d.f32[2] = y;
+    d.f32[1] = z;
+    d.f32[0] = w;
+}
+
 inline simde__m128i simde_mm_adds_epu32(simde__m128i a, simde__m128i b)
 {
     return simde_mm_add_epi32(a, simde_mm_min_epu32(simde_mm_xor_si128(a, simde_mm_cmpeq_epi32(a, a)), b));

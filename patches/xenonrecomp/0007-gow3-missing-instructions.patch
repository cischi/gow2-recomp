+// ---- GoW3 (patches/xenonrecomp/0007) ----
+// XER[CA] comes from the low 32 bits, as XenonRecomp's addze/adde/subfe.
+
+// addc rD,rA,rB: rD = rA + rB, CA = carry out of the low word.
+inline uint64_t ppc_addc(uint64_t a, uint64_t b, PPCXERRegister& xer) noexcept
+{
+    xer.ca = uint32_t(a) + uint32_t(b) < uint32_t(a);
+    return a + b;
+}
+
+// addme rD,rA: rD = rA + CA - 1; carry out of rA + CA + 0xFFFFFFFF, i.e. rA + CA != 0.
+inline uint64_t ppc_addme(uint64_t a, PPCXERRegister& xer) noexcept
+{
+    const uint64_t r = a + xer.ca - 1;
+    xer.ca = uint32_t(a) != 0 || xer.ca;
+    return r;
+}
+
+// subfze rD,rA: rD = ~rA + CA; carry only if ~rA is all ones (rA = 0) and CA = 1.
+inline uint64_t ppc_subfze(uint64_t a, PPCXERRegister& xer) noexcept
+{
+    const uint64_t r = ~a + xer.ca;
+    xer.ca = uint32_t(a) == 0 && xer.ca;
+    return r;
+}
+
+// mulhdu rT,rA,rB: high 64 bits of the unsigned 128-bit product.
+inline uint64_t ppc_mulhdu(uint64_t a, uint64_t b) noexcept
+{
+    return uint64_t((unsigned __int128)a * b >> 64);
+}
+
+// vslh/vsrh/vsrah vD,vA,vB: each halfword shifted by the low 4 bits of the same
+// halfword of vB. Lane-wise, so the byte-reversed layout does not matter: the
+// count is the low byte of the host halfword. Each element is read before it is
+// written, so vD may alias vA or vB.
+inline void ppc_vslh(PPCVRegister& d, const PPCVRegister& a, const PPCVRegister& b) noexcept
+{
+    for (size_t i = 0; i < 8; i++)
+        d.u16[i] = uint16_t(a.u16[i] << (b.u16[i] & 0xF));
+}
+
+inline void ppc_vsrh(PPCVRegister& d, const PPCVRegister& a, const PPCVRegister& b) noexcept
+{
+    for (size_t i = 0; i < 8; i++)
+        d.u16[i] = uint16_t(a.u16[i] >> (b.u16[i] & 0xF));
+}
+
+inline void ppc_vsrah(PPCVRegister& d, const PPCVRegister& a, const PPCVRegister& b) noexcept
+{
+    for (size_t i = 0; i < 8; i++)
+        d.s16[i] = int16_t(a.s16[i] >> (b.u16[i] & 0xF));
+}
+
+// vaddsws vD,vA,vB: signed words, sum saturated to [INT32_MIN, INT32_MAX].
+// VSCR[SAT] is not modelled.
+inline void ppc_vaddsws(PPCVRegister& d, const PPCVRegister& a, const PPCVRegister& b) noexcept
+{
+    for (size_t i = 0; i < 4; i++)
+    {
+        const int64_t sum = int64_t(a.s32[i]) + int64_t(b.s32[i]);
+        d.s32[i] = int32_t(sum > INT32_MAX ? INT32_MAX : sum < INT32_MIN ? INT32_MIN : sum);
+    }
+}
+
+// vcmpbfp[128] vD,vA,vB: per float, bit 0 = !(vA <= vB), bit 1 = !(vA >= -vB),
+// the other bits 0 (a NaN sets both). Returns true if every element is in bounds
+// (all results 0): the record form puts it in CR6[eq].
+inline bool ppc_vcmpbfp(PPCVRegister& d, const PPCVRegister& a, const PPCVRegister& b) noexcept
+{
+    simde__m128 va = simde_mm_load_ps(a.f32);
+    simde__m128 vb = simde_mm_load_ps(b.f32);
+    simde__m128 negb = simde_mm_xor_ps(vb, simde_mm_set1_ps(-0.0f));
+    // ~(a <= b), not cmpnle: simde maps cmpnle/cmpnge to cmpgt/cmplt, false for NaN
+    simde__m128i le = simde_mm_andnot_si128(simde_mm_castps_si128(simde_mm_cmple_ps(va, vb)), simde_mm_set1_epi32(int(0x80000000)));
+    simde__m128i ge = simde_mm_andnot_si128(simde_mm_castps_si128(simde_mm_cmpge_ps(va, negb)), simde_mm_set1_epi32(0x40000000));
+    simde__m128i r = simde_mm_or_si128(le, ge);
+    simde_mm_store_si128((simde__m128i*)d.u8, r);
+    return simde_mm_testz_si128(r, r) != 0;
+}

+static std::vector<ppc_insn> PatternInstructions(const uint32_t* code, size_t base, size_t count)
+{
+    std::vector<ppc_insn> insns;
+    for (size_t i = 0; insns.size() < count; i++)
+    {
+        if (IsNop(code[i]))
+            continue;
+        ppc::Disassemble(&code[i], base + 4 * i, insns.emplace_back());
+    }
+    return insns;

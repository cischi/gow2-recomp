{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-release",
      "displayName": "clang-cl Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang-cl.exe",
        "CMAKE_LINKER": "C:/Program Files/LLVM/bin/lld-link.exe",
        "CMAKE_CXX_STANDARD": "23"
      }
    }
  ],
  "buildPresets": [
    { "name": "clang-release", "configurePreset": "clang-release" }
  ],
  "testPresets": [
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "clang-release-fast",
      "displayName": "Short suite (without the tests labeled lungo)",
      "configurePreset": "clang-release",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "lungo" } },
      "execution": { "jobs": 8 }
    }
  ]
}

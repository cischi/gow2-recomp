+  // gow2: patch 0019, a fetch constant whose weights the shader queries
+  // (getWeights2D) is filtered by hand: point taps at the offsets of the tfetch
+  // instructions blended with the weights. On a resolution-scaled texture the
+  // taps (offsets in host texels) and the weights (host texel fractions) stay
+  // on the same grid, otherwise the taps switch host texel in the middle of a
+  // guest texel while the weights do not (banded shadows in Gears of War 3's
+  // PCF). Only if the constant has both tfetch and getWeights2D and every
+  // fetch on it reads the same coordinate XY operand, so the taps differ only
+  // by instruction offsets (which are rescaled); taps computed in ALU stay in
+  // guest texels and keep upstream's guest-grid weights.
+  // shortcut: the operand is compared by register number, not by value (a
+  // register rewritten between the fetches still matches), upgrade to a data
+  // flow check if a title matches with ALU-computed taps.
+  bool gow2_host_grid_filter = false;
+  if (draw_resolution_scale_x_ > 1 || draw_resolution_scale_y_ > 1) {
+    const InstructionOperand* gow2_coord = nullptr;
+    bool gow2_same_coord = true, gow2_has_weights = false, gow2_has_taps = false;
+    for (const Shader::TextureBinding& binding :
+         current_shader().texture_bindings()) {
+      const ParsedTextureFetchInstruction& fetch = binding.fetch_instr;
+      if (binding.fetch_constant != tfetch_index ||
+          (fetch.opcode != FetchOpcode::kTextureFetch &&
+           fetch.opcode != FetchOpcode::kGetTextureWeights)) {
+        continue;
+      }
+      if (!gow2_coord) {
+        gow2_coord = &fetch.operands[0];
+      } else if ((fetch.operands[0].GetIdenticalComponents(*gow2_coord) &
+                  0b0011) != 0b0011) {
+        gow2_same_coord = false;
+      }
+      if (fetch.opcode == FetchOpcode::kTextureFetch) {
+        gow2_has_taps = true;
+      } else {
+        gow2_has_weights |= fetch.dimension == xenos::FetchOpDimension::k2D;
+      }
+    }
+    gow2_host_grid_filter = gow2_has_weights && gow2_has_taps && gow2_same_coord;
+  }

+// gow2: patch 0017, owner's MSAA, pitch in pixels, viewport and scissor
+// scaled by the sample ratio; original registers restored at the end of the draw.
+D3D12CommandProcessor::Gow2ClearRemap::~Gow2ClearRemap() {
+  for (uint32_t i = 0; i < saved_count_; ++i) {
+    regs_[saved_[i].first] = saved_[i].second;
+  }
+}
+
+void D3D12CommandProcessor::Gow2ClearRemap::Apply(
+    xenos::MsaaSamples owner_msaa) {
+  auto surface_info = regs_.Get<reg::RB_SURFACE_INFO>();
+  uint32_t scale_x = (surface_info.msaa_samples >= xenos::MsaaSamples::k4X)
+                         ? (owner_msaa >= xenos::MsaaSamples::k4X ? 1 : 2)
+                         : 1;
+  uint32_t scale_y = (surface_info.msaa_samples >= xenos::MsaaSamples::k2X)
+                         ? (owner_msaa >= xenos::MsaaSamples::k2X ? 1 : 2)
+                         : 1;
+  if (surface_info.surface_pitch * scale_x > 0x3FFF) {
+    return;
+  }
+  auto save = [this](uint32_t reg) {
+    saved_[saved_count_++] = std::make_pair(reg, regs_[reg]);
+  };
+  for (uint32_t reg :
+       {uint32_t(XE_GPU_REG_RB_SURFACE_INFO),
+        uint32_t(XE_GPU_REG_PA_CL_VPORT_XSCALE),
+        uint32_t(XE_GPU_REG_PA_CL_VPORT_XOFFSET),
+        uint32_t(XE_GPU_REG_PA_CL_VPORT_YSCALE),
+        uint32_t(XE_GPU_REG_PA_CL_VPORT_YOFFSET),
+        uint32_t(XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL),
+        uint32_t(XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR),
+        uint32_t(XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL),
+        uint32_t(XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR),
+        uint32_t(XE_GPU_REG_PA_CL_VTE_CNTL)}) {
+    save(reg);
+  }
+  surface_info.msaa_samples = owner_msaa;
+  surface_info.surface_pitch *= scale_x;
+  regs_[XE_GPU_REG_RB_SURFACE_INFO] = surface_info.value;
+  // Host position = x * scale + offset + h (h = 0.5 with the D3D pixel
+  // center, draw_util::GetHostViewportInfo): to get s times the 4x one we need
+  // scale * s and offset * s + (s - 1) * h. Viewport off: scale 1, offset 0.
+  auto vte = regs_.Get<reg::PA_CL_VTE_CNTL>();
+  bool viewport_enabled = vte.vport_x_scale_ena;
+  float half_pixel = (cvars::half_pixel_offset &&
+                      regs_.Get<reg::PA_SU_VTX_CNTL>().pix_center ==
+                          xenos::PixelCenter::kD3DZero)
+                         ? 0.5f
+                         : 0.0f;
+  auto set_float = [this](uint32_t reg, float value) {
+    std::memcpy(&regs_[reg], &value, sizeof(value));
+  };
+  auto get_or = [this, viewport_enabled](uint32_t reg, float disabled) {
+    return viewport_enabled ? regs_.Get<float>(reg) : disabled;
+  };
+  set_float(XE_GPU_REG_PA_CL_VPORT_XSCALE,
+            get_or(XE_GPU_REG_PA_CL_VPORT_XSCALE, 1.0f) * float(scale_x));
+  set_float(XE_GPU_REG_PA_CL_VPORT_YSCALE,
+            get_or(XE_GPU_REG_PA_CL_VPORT_YSCALE, 1.0f) * float(scale_y));
+  set_float(XE_GPU_REG_PA_CL_VPORT_XOFFSET,
+            get_or(XE_GPU_REG_PA_CL_VPORT_XOFFSET, 0.0f) * float(scale_x) +
+                float(scale_x - 1) * half_pixel);
+  set_float(XE_GPU_REG_PA_CL_VPORT_YOFFSET,
+            get_or(XE_GPU_REG_PA_CL_VPORT_YOFFSET, 0.0f) * float(scale_y) +
+                float(scale_y - 1) * half_pixel);
+  vte.vport_x_scale_ena = 1;
+  vte.vport_x_offset_ena = 1;
+  vte.vport_y_scale_ena = 1;
+  vte.vport_y_offset_ena = 1;
+  regs_[XE_GPU_REG_PA_CL_VTE_CNTL] = vte.value;
+  applied_ = true;
+  auto window_tl = regs_.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto window_br = regs_.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  window_tl.tl_x = std::min(window_tl.tl_x * scale_x, uint32_t(0x3FFF));
+  window_tl.tl_y = std::min(window_tl.tl_y * scale_y, uint32_t(0x3FFF));
+  window_br.br_x = std::min(window_br.br_x * scale_x, uint32_t(0x3FFF));
+  window_br.br_y = std::min(window_br.br_y * scale_y, uint32_t(0x3FFF));
+  regs_[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL] = window_tl.value;
+  regs_[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR] = window_br.value;
+  auto screen_tl = regs_.Get<reg::PA_SC_SCREEN_SCISSOR_TL>();
+  auto screen_br = regs_.Get<reg::PA_SC_SCREEN_SCISSOR_BR>();
+  screen_tl.tl_x = std::min(screen_tl.tl_x * int32_t(scale_x), 0x3FFF);
+  screen_tl.tl_y = std::min(screen_tl.tl_y * int32_t(scale_y), 0x3FFF);
+  screen_br.br_x = std::min(screen_br.br_x * int32_t(scale_x), 0x3FFF);
+  screen_br.br_y = std::min(screen_br.br_y * int32_t(scale_y), 0x3FFF);
+  regs_[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL] = screen_tl.value;
+  regs_[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR] = screen_br.value;
+}

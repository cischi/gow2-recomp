+// gow2: patch 0017, rectangle that rewrites depth and/or stencil with a
+// per-sample value independent of position (ALWAYS test), in screen
+// coordinates (viewport scale and offset off, like the XDK Clear) or with the
+// viewport on, overflowing the surface at the left, top and right.
+static bool Gow2IsClearRectangle(const RegisterFile& regs) {
+  reg::RB_DEPTHCONTROL depth_control =
+      draw_util::GetNormalizedDepthControl(regs);
+  bool writes_depth = depth_control.z_enable && depth_control.z_write_enable;
+  if (!writes_depth && !depth_control.stencil_enable) {
+    return false;
+  }
+  if (depth_control.z_enable &&
+      depth_control.zfunc != xenos::CompareFunction::kAlways) {
+    return false;
+  }
+  if (depth_control.stencil_enable &&
+      (depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+       (depth_control.backface_enable &&
+        (depth_control.stencilfunc_bf != xenos::CompareFunction::kAlways ||
+         depth_control.stencilzpass_bf != depth_control.stencilzpass)))) {
+    return false;
+  }
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  if (window_offset.window_x_offset || window_offset.window_y_offset) {
+    return false;
+  }
+  if (!vte.vport_x_scale_ena && !vte.vport_x_offset_ena &&
+      !vte.vport_y_scale_ena && !vte.vport_y_offset_ena) {
+    return true;
+  }
+  if (!vte.vport_x_scale_ena || !vte.vport_x_offset_ena ||
+      !vte.vport_y_scale_ena || !vte.vport_y_offset_ena) {
+    return false;
+  }
+  float x_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE));
+  float x_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET);
+  float y_scale = std::abs(regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE));
+  float y_offset = regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET);
+  // First Xenos sample at 0.25 px from the pixel edge.
+  return x_offset - x_scale <= 0.25f && y_offset - y_scale <= 0.25f &&
+         x_offset + x_scale >=
+             float(regs.Get<reg::RB_SURFACE_INFO>().surface_pitch);
+}

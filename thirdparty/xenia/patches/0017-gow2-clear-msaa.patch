+// gow2: patch 0017, see the declaration.
+bool RenderTargetCache::Gow2GetLowerMsaaDepthOwner(
+    xenos::MsaaSamples& owner_msaa_out) const {
+  if (GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  const RegisterFile& regs = register_file();
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto rb_depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  xenos::MsaaSamples msaa_samples = rb_surface_info.msaa_samples;
+  uint32_t pitch_tiles_at_32bpp =
+      ((rb_surface_info.surface_pitch
+        << uint32_t(msaa_samples >= xenos::MsaaSamples::k4X)) +
+       (xenos::kEdramTileWidthSamples - 1)) /
+      xenos::kEdramTileWidthSamples;
+  uint32_t base_tiles = rb_depth_info.depth_base;
+  auto it = ownership_ranges_.upper_bound(base_tiles);
+  if (it == ownership_ranges_.begin()) {
+    return false;
+  }
+  --it;
+  if (it->second.end_tiles <= base_tiles) {
+    return false;
+  }
+  RenderTargetKey owner = it->second.render_target;
+  if (owner.IsEmpty() || !owner.is_depth || owner.next_period ||
+      owner.base_tiles != base_tiles ||
+      owner.pitch_tiles_at_32bpp != pitch_tiles_at_32bpp ||
+      owner.resource_format != uint32_t(rb_depth_info.depth_format) ||
+      owner.msaa_samples >= msaa_samples) {
+    return false;
+  }
+  owner_msaa_out = owner.msaa_samples;
+  return true;
+}

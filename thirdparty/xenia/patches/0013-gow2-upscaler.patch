+// gow2: see d3d12_texture_cache.h (patch 0013).
+ID3D12Resource* D3D12TextureCache::Gow2ActiveTexture(
+    uint32_t fetch_constant_index) const {
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  return binding && binding->texture
+             ? static_cast<D3D12Texture*>(binding->texture)->resource()
+             : nullptr;
+}
+
+bool D3D12TextureCache::Gow2CopyActiveTexture(uint32_t fetch_constant_index,
+                                              ID3D12Resource* dst,
+                                              uint32_t width, uint32_t height) {
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (!binding || !binding->texture) {
+    return false;
+  }
+  auto* texture = static_cast<D3D12Texture*>(binding->texture);
+  // The tracked state stays as before: the copy restores it.
+  const D3D12_RESOURCE_STATES state =
+      texture->SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  texture->SetResourceState(state);
+  return command_processor_.Gow2CopyRect(texture->resource(), state, dst,
+                                         width, height);
+}

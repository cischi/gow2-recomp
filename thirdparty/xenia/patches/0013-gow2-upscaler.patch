+  return render_target ? render_target->resource() : nullptr;
+}
+
+bool D3D12RenderTargetCache::Gow2CopyColorTarget0(ID3D12Resource* dst,
+                                                  uint32_t width,
+                                                  uint32_t height) {
+  if (GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  auto* render_target = static_cast<D3D12RenderTarget*>(
+      last_update_accumulated_render_targets()[1]);
+  if (!render_target) {
+    return false;
+  }
+  // The tracked state stays as before: the copy restores it.
+  const D3D12_RESOURCE_STATES state =
+      render_target->SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  render_target->SetResourceState(state);
+  return command_processor_.Gow2CopyRect(render_target->resource(), state, dst,
+                                         width, height);
+}

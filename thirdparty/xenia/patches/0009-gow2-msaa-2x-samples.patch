diff --git a/src/xenia/gpu/draw_util.cc b/src/xenia/gpu/draw_util.cc
index fa99a4f..1b0808e 100644
--- a/src/xenia/gpu/draw_util.cc
+++ b/src/xenia/gpu/draw_util.cc
@@ -468,6 +468,26 @@ void GetHostViewportInfo(GetViewportInfoArgs* XE_RESTRICT args,
     offset_add_xy[0] += 0.5f;
     offset_add_xy[1] += 0.5f;
   }
+  // gow2: the console has 2x sample 0 at (-4, +4)/16 and sample 1 at (+4, -4)/16
+  // (the 360 runtime shifts the viewport of 2x draws by (-0.25, +0.25) guest px
+  // to bring sample 0 to the pixel center); here guest sample 0 is the host's
+  // top-left one, fixed at (-0.25, -0.25) host px at every internal
+  // resolution, so the difference depends on the scale: in guest px it is
+  // (0.25 - 0.25 / sx, -0.25 - 0.25 / sy), i.e. (0, -0.5) at 1x and
+  // (+0.125, -0.375) at 2x, and sample 0 sees what the console sees. The
+  // fallback to 4x MSAA (host without native 2x) is not covered by the formula.
+  // Canary's Xenos positions (xenos_sample_positions) on the rtv path give
+  // a wrong depth after a transfer from 1x
+  // (d3d12_msaa: 2x depth from sample 0 after a transfer from 1x).
+  // Patch 0009.
+  // shortcut: sample 1 is not where it is on the console and the resolved color
+  // is shifted like the geometry (half a pixel in y at 1x), upgrade: canary's
+  // Xenos positions once they give the right depth after transfers too
+  if (args->msaa_2x_sample_0_to_console &&
+      args->msaa_samples == xenos::MsaaSamples::k2X) {
+    offset_add_xy[0] += 0.25f - 0.25f / float(args->draw_resolution_scale_x);
+    offset_add_xy[1] -= 0.25f + 0.25f / float(args->draw_resolution_scale_y);
+  }
   // Only scale the whole pixel part of the viewport offset. Keep the Xenos
   // sample offset in host pixels since programmed sample positions don't scale
   // (see kXenosSamplePositions2x).

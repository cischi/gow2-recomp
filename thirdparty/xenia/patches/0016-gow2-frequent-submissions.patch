+// gow2: with strict occlusion queries the game waits for a result every
+// frame; closing the submission every N draws starts the GPU earlier and
+// shortens the wait (patch 0016).
+DEFINE_uint32(d3d12_submit_every_draws, 0,
+              "Submit the command list after this many draws if it's possible "
+              "to submit immediately, so the GPU starts earlier (0 = only at "
+              "primary buffer ends and swaps).",
+              "D3D12");
 
